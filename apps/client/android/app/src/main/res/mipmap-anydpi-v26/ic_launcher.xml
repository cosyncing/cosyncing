<?xml version="1.0" encoding="utf-8"?>
<!--
  cosyncing adaptive launcher icon (assets/brand/HANDOVER.md step 1).
  Layers are rendered from the locked masters by scripts/wire_brand_icons.sh;
  the foreground keeps the defining mark inside the 66dp safe zone and the
  monochrome layer enables Android 13+ themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
