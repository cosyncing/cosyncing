{
  "schemaVersion": 1,
  "lanes": [
    "native-identity",
    "terminal-authority",
    "history-live-chronology",
    "replacement",
    "hub-authority"
  ],
  "adapters": {
    "CodexAdapter": {
      "coverage": {
        "native-identity": ["session-truth-conformance"],
        "terminal-authority": ["session-truth-conformance"],
        "history-live-chronology": ["session-truth-conformance"],
        "replacement": ["session-truth-conformance"],
        "hub-authority": ["session-truth-conformance"]
      }
    },
    "ClaudeAdapter": {
      "coverage": {
        "native-identity": ["claude-transcript-mapping"],
        "terminal-authority": [],
        "history-live-chronology": ["claude-transcript-mapping"],
        "replacement": ["roster-revision"],
        "hub-authority": ["session-truth-conformance"]
      },
      "exclusions": {
        "terminal-authority": {
          "reason": "claude-transcript-mapping pins the transcript→canonical mapping and the compact_boundary history reset, but no reviewed broker sub-suite asserts the Claude adapter's run-state terminal/completion fences; accepted gap pending a Claude terminal-authority lane.",
          "reviewed": "2026-08-04"
        }
      }
    },
    "OpenCodeAdapter": {
      "coverage": {
        "native-identity": ["opencode-message-identity"],
        "terminal-authority": ["opencode-completion-fence"],
        "history-live-chronology": ["opencode-message-identity"],
        "replacement": [],
        "hub-authority": ["session-truth-conformance"]
      },
      "exclusions": {
        "replacement": {
          "reason": "No broker sub-suite exercises OpenCode incarnation replacement: the broker-owned OpenCode conformance coverage has no retireSupersededOwners/replacement assertion, and OpenCode session ids are stable server-side ids with no observed adapter-id swap; accepted gap.",
          "reviewed": "2026-08-04"
        }
      }
    },
    "PiAdapter": {
      "coverage": {
        "native-identity": ["pi-tool-result"],
        "terminal-authority": ["pi-bridge-reload"],
        "history-live-chronology": [],
        "replacement": ["pi-bridge-reload"],
        "hub-authority": ["session-truth-conformance"]
      },
      "exclusions": {
        "history-live-chronology": {
          "reason": "The Pi live surface is a bridge to the upstream Pi runtime's own keyed event stream; the broker holds no native Pi rollout/history source it could re-derive live-vs-history chronology against (resume replay is upstream-owned via pi --mode rpc get_messages), so this lane is not applicable to the bridge path.",
          "reviewed": "2026-08-04"
        }
      }
    },
    "OmpAdapter": {
      "coverage": {
        "native-identity": ["omp-bridge"],
        "terminal-authority": ["omp-bridge"],
        "history-live-chronology": [],
        "replacement": ["omp-bridge"],
        "hub-authority": ["session-truth-conformance"]
      },
      "exclusions": {
        "history-live-chronology": {
          "reason": "Same bridge shape as Pi: the omp live surface is the upstream oh-my-pi runtime's own keyed event stream relayed by the shared engine; the broker holds no native omp rollout/history source it could re-derive live-vs-history chronology against, so this lane is not applicable to the bridge path.",
          "reviewed": "2026-08-27"
        }
      }
    },
    "KimiAdapter": {
      "coverage": {
        "native-identity": ["kimi-mapping"],
        "terminal-authority": ["kimi-drive"],
        "history-live-chronology": ["kimi-observe", "kimi-attach-priming"],
        "replacement": ["kimi-drive", "kimi-observe"],
        "hub-authority": ["kimi-attach-priming", "kimi-drive-authority"]
      }
    },
    "DshAdapter": {
      "coverage": {
        "native-identity": ["dsh-mapping"],
        "terminal-authority": ["dsh-observe", "dsh-attach-priming"],
        "history-live-chronology": ["dsh-observe", "dsh-attach-priming"],
        "replacement": ["dsh-observe", "dsh-attach-priming"],
        "hub-authority": ["dsh-attach-priming"]
      }
    },
    "AgyAdapter": {
      "coverage": {
        "native-identity": ["agy-store", "agy-identity"],
        "terminal-authority": ["agy-drive", "agy-observe"],
        "history-live-chronology": ["agy-identity", "agy-observe"],
        "replacement": ["agy-identity"],
        "hub-authority": ["agy-cross-client-join", "agy-registration-gate"]
      }
    }
  }
}
