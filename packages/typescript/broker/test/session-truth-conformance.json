      "exclusions": {
        "history-live-chronology": {
          "reason": "The Pi live surface is a bridge to the upstream Pi runtime's own keyed event stream; the broker holds no native Pi rollout/history source it could re-derive live-vs-history chronology against (resume replay is upstream-owned via pi --mode rpc get_messages), so this lane is not applicable to the bridge path.",
          "reviewed": "2026-08-04"
        }
