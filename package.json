    "test:broker-echo-correlation": "bun run scripts/broker/tests/broker/test-app-send-echo-correlation.ts",
    "test:broker-drive-restore": "bun run scripts/broker/tests/broker/test-drive-restore-arbitration.ts",
    "test:broker-fork-agent-owned": "bun run scripts/broker/tests/broker/test-fork-agent-owned.ts",
    "test:broker-request-resolution": "bun run scripts/broker/tests/broker/test-request-resolution-hygiene.ts",
    "test:broker-attention-bulk": "bun run scripts/broker/tests/broker/test-attention-bulk-dismiss.ts",
    "test:broker-draft-durability": "bun run scripts/broker/tests/broker/test-draft-durability.ts",
    "test:broker-draft-sync-wire": "bun run scripts/broker/tests/broker/test-draft-sync.ts",
    "test:broker-draft-two-client-wire": "bun run scripts/broker/tests/broker/test-draft-two-client-wire.ts",
    "test:broker-protocol-journal": "bun run scripts/broker/tests/broker/test-protocol-journal.ts",
    "test:broker-history-page-cache": "bun run scripts/broker/tests/broker/test-history-page-cache.ts",
    "test:broker-history-paging": "bun run scripts/broker/tests/broker/test-history-page-wire.ts",
    "test:broker-codex-history-paging": "bun run scripts/broker/tests/broker/test-codex-history-page-wire.ts",
    "test:codex-history-paging-large": "bun run scripts/broker/tests/codex/history-paging-large.ts",
    "test:codex-history-refusal-tail": "bun run scripts/broker/tests/codex/history-refusal-tail.ts",
