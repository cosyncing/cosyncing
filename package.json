    "test:broker-roster-watcher-live": "bun run scripts/broker/tests/broker/test-roster-watcher-publication-live.ts",
    "test:broker-model-session-creation": "bun run scripts/broker/tests/broker/test-model-session-creation.ts",
    "test:broker-agent-create-readiness": "bun run scripts/broker/tests/broker/test-agent-create-readiness.ts && bun run scripts/broker/tests/broker/test-opencode-create-readiness-restart.ts",
    "test:broker-roster-revision": "bun run scripts/broker/tests/broker/test-roster-revision.ts",
    "test:broker-adapter-discovery-bounds": "bun run scripts/broker/tests/broker/test-adapter-discovery-bounds.ts",
    "test:broker-sync-degraded-integration": "bun run scripts/broker/tests/broker/test-sync-degraded-integration.ts",
    "test:broker-control-boundaries": "bun run scripts/broker/tests/broker/test-control-boundaries.ts",
    "test:broker-artifact-session-isolation": "bun run scripts/broker/tests/broker/test-artifact-session-isolation.ts",
    "test:release-supply-chain": "bun run scripts/broker/tests/broker/test-release-supply-chain.ts && bun run test:release-checkpoint-lifecycle && bun run test:release-web-sidecar && bun run test:release-candidate-verifier",
