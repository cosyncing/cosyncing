    "release:assemble": "bun run scripts/broker/release/assemble-release.ts",
    "release:package-web": "bun run scripts/broker/release/package-web-sidecar.ts",
    "release:verify-pair": "bun run scripts/broker/release/verify-candidate-pair.ts",
    "verification:validate": "bun run scripts/verification/validate-verification-graph.ts",
    "verification:generate-completeness-anchor": "bun run scripts/verification/generate-verification-completeness-anchor.ts",
    "verification:isolation-audit": "bun run scripts/verification/audit-suite-isolation.ts --json output/verification/suite-isolation.json",
    "verification:isolation-check": "bun run scripts/verification/audit-suite-isolation.ts --check",
    "verification:check": "bun run verification:validate && bun run test:verification-graph && bun run test:changed-gates && bun run test:fixture-isolation && bun run test:supervised-process && bun run verification:isolation-check",
    "test:verification-graph": "bun run scripts/verification/tests/test-verification-graph.ts",
    "test:changed-gates": "bun run scripts/verification/tests/test-changed-gates.ts",
    "test:browser-broker-overlap": "bun run scripts/verification/tests/stress-browser-broker-overlap.ts",
    "test:fixture-isolation": "bun run scripts/verification/tests/test-fixture-isolation.ts",
    "test:supervised-process": "bun run scripts/verification/tests/test-supervised-process.ts",
    "release:checkpoint": "bun run scripts/release/verify-release-checkpoint.ts",
    "typecheck": "bunx tsc --build",
    "check:broker-surface": "bun run scripts/broker/check-broker-surface.ts",
    "capabilities:check": "bun run scripts/broker/capabilities/check.ts --agent opencode --mode fixture",
    "capabilities:drift": "bun run scripts/broker/capabilities/check-discovery-drift.ts --agent opencode --openapi scripts/broker/capabilities/fixtures/opencode/openapi.synthetic-drift.json --write-output output/capabilities/opencode/fixture-drift",
    "capabilities:pi-check": "bun run scripts/broker/capabilities/check.ts --agent pi --mode fixture",
    "capabilities:pi-drift": "bun run scripts/broker/capabilities/check-discovery-drift.ts --agent pi --rpc-types scripts/broker/capabilities/fixtures/pi/rpc-types.synthetic-drift.d.ts --write-output output/capabilities/pi/fixture-drift",
    "capabilities:codex-check": "bun run scripts/broker/capabilities/check.ts --agent codex --mode fixture",
    "capabilities:codex-drift": "bun run scripts/broker/capabilities/check-discovery-drift.ts --agent codex --methods scripts/broker/capabilities/fixtures/codex/appserver-methods.synthetic-drift.json --write-output output/capabilities/codex/fixture-drift",
    "capabilities:claude-check": "bun run scripts/broker/capabilities/check.ts --agent claude --mode fixture",
    "capabilities:tool-branches": "bun run scripts/broker/capabilities/check-no-tool-branches.ts --write-output output/capabilities/tool-branches",
    "test:capabilities": "bun run scripts/broker/tests/capabilities/test-capabilities.ts",
    "serve:tailscale": "bash scripts/broker/tailscale-serve.sh",
    "trace:real-agent-p0": "bash scripts/broker/tests_traces/run-real-agent-p0.sh",
    "trace:opencode-reconnect": "COSYNCING_OPENCODE_RECONNECT_TRACE=1 bun run scripts/broker/tests_traces/opencode-reconnect-trace.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "1.5.6",
    "playwright-core": "1.61.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "qrcode": "1.5.4"
  }
}
