    "test:broker-setup": "bun run scripts/broker/tests/broker/test-transactional-setup.ts",
    "test:broker-service": "bun run scripts/broker/tests/broker/test-service-lifecycle.ts",
    "test:broker-pairing": "bun run scripts/broker/tests/broker/test-tailscale-pairing.ts",
    "test:broker-lifecycle": "bun run scripts/broker/tests/broker/test-broker-lifecycle.ts",
