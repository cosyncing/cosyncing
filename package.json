{
  "name": "cosyncing",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "license": "Apache-2.0",
  "type": "module",
  "description": "cosyncing — view and drive CLI coding-agent sessions through your own broker.",
  "workspaces": [
    "packages/typescript/protocol",
    "packages/typescript/adapter-api",
    "packages/typescript/crypto",
    "packages/typescript/transport",
    "packages/typescript/transport-wire",
    "packages/typescript/broker",
    "packages/typescript/adapters/*",
    "apps/poc-ui"
  ],
  "scripts": {
    "broker": "bun run packages/typescript/broker/src/cli.ts broker --dev-bypass-first-run",
    "broker:direct": "bun run packages/typescript/broker/src/main.ts",
    "dev": "bun run --watch packages/typescript/broker/src/cli.ts broker --dev-bypass-first-run",
    "client:pub-get": "bun run scripts/client/run-client-command.ts flutter pub get",
    "client:format": "bun run scripts/client/run-client-command.ts dart format --output=none --set-exit-if-changed lib test tool integration_test test_driver ../../packages/dart",
    "client:analyze": "bun run scripts/client/run-client-command.ts flutter analyze",
    "client:test": "bun run scripts/client/run-client-command.ts flutter test",
    "client:test:contract": "bun run scripts/client/run-client-command.ts flutter test test/contract",
    "client:build:web": "bun run scripts/client/build-web.ts",
    "client:build:desktop": "bun run scripts/client/build-desktop.ts",
    "client:build:android": "bun run scripts/client/build-android.ts",
    "client:check": "bun run scripts/client/check.ts",
    "test:desktop-build-command": "bun run scripts/client/tests/test-desktop-build-command.ts",
    "test:client-release-policy": "bun run scripts/client/tests/test-client-release-policy.ts",
    "client:profile-tests": "bun run scripts/client/profile-tests.ts",
    "check": "bun run scripts/check.ts",
    "check:changed": "bun run scripts/check.ts --changed",
    "app:rebuild-restart": "bash scripts/dev/rebuild-restart-app.sh",
    "test:web-static-cache": "bun run scripts/client/tests/test-web-static-cache.ts",
    "test:web-update-handoff": "bun run scripts/client/tests/test-web-update-handoff.ts",
    "test:web-startup-shell": "bun run client:build:web && node scripts/client/tests/test-startup-shell-browser.mjs",
    "test:web-startup-shell:built": "node scripts/client/tests/test-startup-shell-browser.mjs",
    "test:web-artifact-session-isolation": "bun run client:build:web && bun run test:web-artifact-session-isolation:built",
    "test:web-artifact-session-isolation:built": "bun run scripts/client/tests/test-web-artifact-session-isolation.ts",
    "test:web-browser:built": "bun run test:web-startup-shell:built && bun run test:web-artifact-session-isolation:built && bun run test:client-browser-platform",
