    "test:release-web-sidecar": "bun run scripts/broker/tests/broker/test-release-web-sidecar.ts",
    "test:release-candidate-verifier": "bun run scripts/broker/tests/broker/test-release-candidate-verifier.ts",
    "test:broker-update-contract": "bun run scripts/broker/tests/broker/test-update-contract.ts",
